# ---------------------------------------------------------------------------
# Todo esto es OPCIONAL. Sin nada de esto la app funciona igual, guardando el
# progreso en el navegador de cada alumno (localStorage).
#
# Con Supabase configurado, además: el progreso sobrevive a cambiar de
# computador, hay tabla de posiciones, y el profesor ve el avance del salón.
# ---------------------------------------------------------------------------

# Project Settings → API → Project URL
SUPABASE_URL=

# Project Settings → API → service_role secret
# OJO: esta llave es secreta y solo se usa desde el servidor. Nunca la pongas
# en una variable que empiece por NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# La clave con la que TÚ entras a /profesor. Invéntate una.
PROFESOR_CLAVE=
